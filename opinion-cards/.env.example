# Copier vers .env.local et remplir. Ne jamais committer .env.local.

# --- Supabase (requis pour la persistance) -----------------------------
# Sans ces variables, l'app tourne sur les cartes de demo (lib/demo-data.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cle service role : usage serveur uniquement, contourne les RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Images (Pexels, gratuit) ------------------------------------------
# Une requete par carte creee ; l'URL est ensuite stockee en base.
PEXELS_API_KEY=

# --- Moderation (OpenAI, gratuite) -------------------------------------
# Si vide ou en erreur, les nouvelles cartes partent en 'pending'.
OPENAI_API_KEY=

# --- Traduction (optionnel) --------------------------------------------
# DeepL est essaye en premier, LibreTranslate sert de repli.
DEEPL_API_KEY=
LIBRETRANSLATE_URL=

# --- Publication -------------------------------------------------------
# 'approved' : publication directe apres moderation automatique.
# 'pending'  : relecture humaine avant publication (recommande au debut).
NEW_STATEMENT_STATUS=approved
